{
  ".source.go": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "block": ["/*", "*/"],
        "line": "//"
      }
    }
  },
  ".source.mod": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//"
      }
    }
  },
  ".source.gotemplate": {
    "editor": {
      "commentStart": "{{/*",
      "commentEnd": "*/}}",
      "commentDelimiters": {
        "block": ["{{/*", "*/}}"]
      }
    }
  },
  ".source.sum": {
    "editor": {
      "commentStart": "",
      "commentEnd": "",
      "commentDelimiters": {}
    }
  }
}
